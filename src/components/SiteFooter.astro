---
/**
 * Shared footer.
 *
 * Closes the page without becoming a second site map: the identity, and a
 * repeat of the destinations so no page is a dead end.
 *
 * External profiles and the email address belong to `src/data/links.ts` and
 * the Connect page; neither exists yet, so neither is invented here.
 */
import { primaryNav, connectNav, isCurrent } from '../data/nav';
import { ui } from '../data/ui';

const path = Astro.url.pathname;
const items = [...primaryNav, connectNav];
---

<footer class="site-footer">
	<div class="inner">
		<a class="wordmark" href="/" aria-label={ui.homeLinkLabel}>{ui.siteName}</a>

		<nav aria-label={ui.footerNavLabel}>
			<ul>
				{
					items.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={isCurrent(path, item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		margin-block-start: var(--space-10);
		padding-block: var(--space-7);
		padding-inline: var(--gutter);
		border-block-start: 1px solid var(--color-border);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-4) var(--space-6);
		max-width: var(--width-standard);
		margin-inline: auto;
	}

	.wordmark {
		font-family: var(--font-display);
		font-size: var(--text-body-lg);
		color: var(--color-text);
		text-decoration: none;
		transition: color var(--duration-base) var(--ease-standard);
	}

	.wordmark:hover {
		color: var(--color-accent);
	}

	nav {
		margin-inline-start: auto;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
		list-style: none;
		padding: 0;
	}

	a:not(.wordmark) {
		display: inline-flex;
		align-items: center;
		/* The 44px touch-target minimum in docs/11_Technical_Standards.md. */
		min-block-size: 44px;
		min-inline-size: 44px;
		color: var(--color-text-muted);
		font-size: var(--text-body-sm);
		text-decoration: none;
		transition: color var(--duration-base) var(--ease-standard);
	}

	a:not(.wordmark):hover {
		color: var(--color-text);
	}

	a[aria-current='page'] {
		color: var(--color-text);
	}

	@media (max-width: 639px) {
		nav {
			margin-inline-start: 0;
			width: 100%;
		}
	}
</style>
